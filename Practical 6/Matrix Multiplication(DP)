
print("================================")
print("     MATRIX CHAIN MULTIPLICATION")
print("================================")

p = [10, 20, 30, 40, 30]

n = len(p) - 1

dp = [[0 for j in range(n + 1)] for i in range(n + 1)]

for length in range(2, n + 1):
    for i in range(1, n - length + 2):
        j = i + length - 1
        dp[i][j] = float('inf')

        for k in range(i, j):
            cost = (
                dp[i][k]
                + dp[k + 1][j]
                + p[i - 1] * p[k] * p[j]
            )

            if cost < dp[i][j]:
                dp[i][j] = cost

print("Minimum number of multiplications:", dp[1][n])
